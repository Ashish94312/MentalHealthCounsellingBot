# Railway-optimized Dockerfile with better caching
FROM python:3.11-slim AS builder

# Install build dependencies (this layer will be cached)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements-production.txt /tmp/requirements.txt

# Install Python dependencies (cached if requirements don't change)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --user -r /tmp/requirements.txt

# Final stage - minimal runtime
FROM python:3.11-slim

# Environment
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=chatbot_project.settings \
    PATH=/root/.local/bin:$PATH

# Copy Python packages from builder
COPY --from=builder /root/.local /root/.local

# Set workdir
WORKDIR /app

# Copy application files
COPY chatbot_project/ /app/chatbot_project/

# Copy only essential model files (exclude checkpoints)
COPY tinylama-mental-health-mentalchat16k/adapter_config.json /app/tinylama-mental-health-mentalchat16k/
COPY tinylama-mental-health-mentalchat16k/adapter_model.safetensors /app/tinylama-mental-health-mentalchat16k/
COPY tinylama-mental-health-mentalchat16k/tokenizer.json /app/tinylama-mental-health-mentalchat16k/
COPY tinylama-mental-health-mentalchat16k/tokenizer_config.json /app/tinylama-mental-health-mentalchat16k/
COPY tinylama-mental-health-mentalchat16k/special_tokens_map.json /app/tinylama-mental-health-mentalchat16k/
COPY tinylama-mental-health-mentalchat16k/chat_template.jinja /app/tinylama-mental-health-mentalchat16k/

# Create non-root user
RUN useradd --create-home --shell /bin/bash app && \
    chown -R app:app /app

# Switch to non-root user
USER app

# Expose port
EXPOSE 8000

# Start command
CMD ["sh", "-c", "python chatbot_project/manage.py migrate && gunicorn chatbot_project.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 1 --timeout 120"]

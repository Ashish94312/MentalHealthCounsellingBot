{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKER_IMAGE",
    "dockerImage": "ashish85297/mental-health-bot:latest"
  },
  "deploy": {
    "startCommand": "python chatbot_project/manage.py migrate && gunicorn chatbot_project.wsgi:application --bind 0.0.0.0:$PORT --workers 1 --timeout 120 --max-requests 1000 --max-requests-jitter 100",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "resources": {
      "memory": "2GB",
      "cpu": "1"
    }
  }
}
